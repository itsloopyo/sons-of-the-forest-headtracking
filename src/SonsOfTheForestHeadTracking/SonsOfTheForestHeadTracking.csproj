<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SonsOfTheForestHeadTracking</AssemblyName>
    <RootNamespace>SonsOfTheForestHeadTracking</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <Authors>itsloopyo</Authors>
    <Copyright>Copyright (c) 2026 itsloopyo. Licensed under the MIT License.</Copyright>
    <Description>Head tracking mod for Sons of the Forest (Unity 2022.2 IL2CPP) using CameraUnlock.Core</Description>
    <!-- libs/ holds BepInEx + Il2CppInterop reference assemblies provisioned by
         scripts/setup-libs.ps1. They are facades over native code, so version conflicts
         and missing-reference warnings from them are expected and not actionable. -->
    <NoWarn>$(NoWarn);MSB3277;CS8002</NoWarn>
  </PropertyGroup>

  <!-- CameraUnlock shared library (framework-agnostic core only - the Unity helper
       assembly targets real UnityEngine reference assemblies, which cannot be mixed
       with the Il2CppInterop proxies this mod compiles against). -->
  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>

  <!-- Unity-coupled CameraUnlock helpers, shared as source for IL2CPP mods. -->
  <PropertyGroup>
    <CameraUnlockFastBoot>true</CameraUnlockFastBoot>
  </PropertyGroup>
  <Import Project="..\..\cameraunlock-core\csharp\il2cpp\CameraUnlock.Core.Unity.Il2Cpp.props" />

  <!-- Restored so scripts/setup-libs.ps1 can copy these two assemblies out of the NuGet
       cache into libs/; libs/ is the project's only reference surface, so the package
       assets themselves are excluded rather than referenced twice. Il2CppInterop.Runtime is
       pinned to the version cameraunlock-core's IL2CPP stubs compile against, so the mod
       and the stubs name one Il2CppReferenceArray. -->
  <ItemGroup>
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.3" ExcludeAssets="all" />
    <PackageReference Include="Il2CppInterop.ReferenceLibs" Version="1.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Reference assemblies, provisioned by scripts/setup-libs.ps1 from the NuGet cache and
       from the checked-in stub sources. Gitignored, and never copied from a game install:
       a contributor who owns the game and a CI runner that does not must compile against
       byte-identical references. -->
  <ItemGroup>
    <GameLib Include="BepInEx.Core" />
    <GameLib Include="BepInEx.Unity.IL2CPP" />
    <GameLib Include="Il2CppInterop.Runtime" />
    <GameLib Include="Il2Cppmscorlib" />
    <GameLib Include="UnityEngine.CoreModule" />
    <GameLib Include="UnityEngine.InputLegacyModule" />
    <GameLib Include="UnityEngine.VideoModule" />
    <GameLib Include="Sons" />

    <Reference Include="@(GameLib)">
      <HintPath>libs\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="libs\**" />
    <None Remove="libs\**" />
  </ItemGroup>
</Project>
